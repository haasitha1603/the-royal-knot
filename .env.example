# The Royal Knot - Environment Configuration Example
# Copy this file to .env for local configuration. Never commit .env to source control!

# Backend API Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (generate a strong secret key for production)
SECRET_KEY=royal_knot_luxury_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL supported, default fallback to SQLite for easy local dev)
DATABASE_URL=sqlite:///./royal_knot.db
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/the_royal_knot

# Business Information Defaults
PLATFORM_NAME="The Royal Knot"
PLATFORM_EMAIL="concierge@theroyalknot.com"
PLATFORM_PHONE="+91 141 289 9000"
SUPPORT_HOURS="9:00 AM - 8:00 PM IST (Mon - Sat)"
REGISTERED_OFFICE="Palace Road, C-Scheme, Jaipur, Rajasthan 302001, India"

# Optional AI / Maps Configuration
AI_ENABLED=true
MAP_TILE_PROVIDER=openstreetmap
